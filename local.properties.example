# AgarthaVision — local secrets template
#
# Copy this file to `local.properties` and fill in the values shared by DMKuZu.
# `local.properties` is gitignored — never commit real keys.
#
# See docs/01_ENVIRONMENT_SETUP.md §B.6 for full setup.

# ── Android SDK ─────────────────────────────────────────────────────────────
# (auto-populated by Android Studio when you open the project — leave blank
# here and let AS write it, or set explicitly if building from CLI only)
# sdk.dir=/home/<you>/Android/Sdk

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys → the **publishable** key, which starts with
# `sb_publishable_` (14zcqntnqxg). Not the legacy `anon` key (a long JWT starting `eyJ`): the
# legacy keys are being disabled, and an APK built with one stops working the moment they are.
# The property keeps its old name, SUPABASE_ANON_KEY_*; only the value changes. If DEV and PROD
# point at the same project, both take the same publishable key.
#
# `staging` and `main` point at agarthavision-dev / agarthavision-prod.
# The patient-records work (feat/patient-records) points its DEV values at the
# separate `agarthavision` project instead — its schema diverges too far to share
# a database with the rest of Sprint 1. Ask for the URL + publishable key out of band.
SUPABASE_URL_DEV=https://<dev-project-ref>.supabase.co
SUPABASE_ANON_KEY_DEV=sb_publishable_<dev-publishable-key>
SUPABASE_URL_PROD=https://<prod-project-ref>.supabase.co
SUPABASE_ANON_KEY_PROD=sb_publishable_<prod-publishable-key>

# ── Sign-in human check (Cloudflare Turnstile, 14zcqntnqxf) ─────────────────
# The widget's site key and the hostname it is registered for, from Cloudflare →
# Turnstile → the widget. Public by design, but kept here like every other per-build value.
# Leave blank to build without the check: sign-in then sends no token, which only works while
# Supabase's CAPTCHA protection is off. A release for medtechs needs both set BEFORE that
# protection is switched on. The widget's secret key never goes in the app; it belongs in
# Supabase → Authentication → Attack Protection.
TURNSTILE_SITE_KEY_DEV=<turnstile-site-key>
TURNSTILE_HOSTNAME_DEV=<widget-hostname>
TURNSTILE_SITE_KEY_PROD=<turnstile-site-key>
TURNSTILE_HOSTNAME_PROD=<widget-hostname>

# ── Inference (self-hosted FastAPI container on a rented GPU droplet) ────────
# DMKuZu spins up the droplet, runs the inference container, and shares the
# IP + bearer key over the team chat. See ADR-003.
#
# Both keys are suffixed. app/build.gradle.kts:67 reads INFERENCE_API_KEY_DEV and
# :90 reads INFERENCE_API_KEY_PROD; an unsuffixed INFERENCE_API_KEY resolves to
# null, which compiles fine and ships an empty bearer token — the inference call
# then fails with a 401 that looks like a server problem. See constraints.md C10.
INFERENCE_URL_DEV=http://<droplet-ip>:8000
INFERENCE_URL_PROD=http://<droplet-ip>:8000
INFERENCE_API_KEY_DEV=<shared-secret-dev>
INFERENCE_API_KEY_PROD=<shared-secret-prod>
