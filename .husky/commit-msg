#!/usr/bin/env sh
# Enforces C9 (docs/constraints.md). The rule lives in tools/qa/commit_format.py,
# which CI also runs, so the hook and the PR check cannot drift apart.

if ! command -v python >/dev/null 2>&1; then
  echo "[Husky] python not found; skipping commit message check (CI will enforce the format)."
  exit 0
fi

python tools/qa/commit_format.py --file "$1"
