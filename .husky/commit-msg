#!/usr/bin/env sh
commit_msg=$(cat "$1")

# Match format: [type][ClickUp-ID][Lastname] Task title
# Example: [feat][CU-869234][Beansman] Implement settings screen
pattern="^\[(feat|fix|refactor|docs|style|test|ci|chore)\]\[[A-Za-z0-9_-]+\]\[[A-Za-z0-9_-]+\] .+"

if ! echo "$commit_msg" | grep -E -q "$pattern"; then
  echo "❌ [Husky] Invalid commit message format!"
  echo "--------------------------------------------------------"
  echo "Required format: [type][ClickUp-ID][Lastname] Task title"
  echo "Allowed types:   feat, fix, refactor, docs, style, test, ci, chore"
  echo "Example:        [feat][CU-869234][Beansman] Implement settings screen"
  echo "--------------------------------------------------------"
  exit 1
fi