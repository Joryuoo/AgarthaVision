#!/usr/bin/env sh
echo "🔍 [Husky] Running pre-commit checks..."

# Auto-detect JAVA_HOME if missing (Windows Android Studio JBR fallback)
if [ -z "$JAVA_HOME" ]; then
  if [ -d "C:/Program Files/Android/Android Studio/jbr" ]; then
    export JAVA_HOME="C:/Program Files/Android/Android Studio/jbr"
    export PATH="$JAVA_HOME/bin:$PATH"
  fi
fi

run_gradle() {
  if [ -f "./gradlew" ]; then
    ./gradlew "$@"
  elif [ -f "./gradlew.bat" ]; then
    ./gradlew.bat "$@"
  else
    gradle "$@"
  fi
}

# 1. Run Kotlin compilation check
echo "⏳ Checking Kotlin compilation..."
run_gradle :app:compileDebugKotlin || {
  echo "❌ [Husky] Kotlin compilation failed! Commit cancelled."
  exit 1
}

# 2. Run unit tests
echo "⏳ Running unit tests..."
run_gradle :app:testDebugUnitTest || {
  echo "❌ [Husky] Unit tests failed! Commit cancelled."
  exit 1
}

# 3. Run full Gradle debug build
echo "⏳ Building Gradle debug APK..."
run_gradle assembleDebug || {
  echo "❌ [Husky] Gradle build (assembleDebug) failed! Commit cancelled."
  exit 1
}

# 4. Run ktlint and detekt linting
echo "⏳ Checking ktlint & detekt linting..."
run_gradle :app:ktlintCheck :app:detekt || {
  echo "❌ [Husky] Linting check failed! Commit cancelled."
  exit 1
}

echo "✅ [Husky] All pre-commit build and test checks passed!"