{
  "name": "agarthavision",
  "private": true,
  "type": "module",
  "scripts": {
    "stop": "python tools/qa/gradle.py --stop",
    "build": "python tools/qa/gradle.py assembleDebug",
    "build:release": "python tools/qa/gradle.py assembleRelease",
    "install:device": "python tools/qa/gradle.py :app:installDebug",
    "test": "python tools/qa/run.py unit",
    "test:all": "python tools/qa/gradle.py :app:test",
    "lint": "python tools/qa/gradle.py ktlintCheck detekt",
    "lint:fix": "python tools/qa/gradle.py ktlintFormat",
    "clean": "python tools/qa/gradle.py clean",
    "sync": "python tools/qa/gradle.py --refresh-dependencies",
    "emulator": "emulator -avd AgarthaVision_Test",
    "prepare": "husky",
    "compile": "python tools/qa/gradle.py :app:compileDebugKotlin",
    "test:screenshots": "python tools/qa/run.py screenshots",
    "test:smoke": "python tools/qa/run.py smoke",
    "test:integration": "python tools/qa/run.py integration",
    "test:unit": "python tools/qa/run.py unit",
    "check": "python tools/qa/run.py check",
    "test:device": "python tools/qa/run.py device",
    "test:api": "python tools/qa/run.py api",
    "qa:evidence": "python tools/qa/run.py evidence",
    "screenshots:record": "python tools/qa/run.py record"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
