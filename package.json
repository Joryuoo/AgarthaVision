{
  "name": "agarthavision",
  "private": true,
  "type": "module",
  "scripts": {
    "stop" : "./gradlew --stop",
    "build": "./gradlew assembleDebug",
    "build:release": "./gradlew assembleRelease",
    "install:device": "./gradlew :app:installDebug",
    "test": "./gradlew testDebugUnitTest",
    "test:all": "./gradlew :app:test",
    "lint": "./gradlew ktlintCheck detekt",
