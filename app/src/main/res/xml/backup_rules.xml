<?xml version="1.0" encoding="utf-8"?>
<!--
    Governs cloud backup on API 30 and below (this is the fleet's Android version).

    android:allowBackup="false" already stops this transport outright. These excludes are
    kept explicit so the intent survives anyone re-enabling backup: the cached identity in
    `datastore/` must not outlive an uninstall, and `agarthavision.db` holds patient records
    that must never reach a consumer cloud backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
    <exclude domain="database" path="agarthavision.db" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
